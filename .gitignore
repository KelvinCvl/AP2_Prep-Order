# ------------------------
# Fichiers binaires / dossiers build
# ------------------------
bin/
obj/
Debug/
Release/
x64/
x86/

# ------------------------
# Visual Studio / IDE
# ------------------------
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# ------------------------
# Logs, cache, temp
# ------------------------
*.log
*.tlog
*.tmp
*.tmp_proj
*.cache
*.history

# ------------------------
# Fichiers générés / code auto
# ------------------------
Generated\ Files/
*.g.cs
*.designer.cs
*.g.i.cs

# ------------------------
# Packages / dépendances
# ------------------------
*.nupkg
**/packages/*
!**/packages/build/
.project.lock.json
artifacts/

# ------------------------
# Visual Studio Code
# ------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------
# Ignore fichiers binaires / déployables
# ------------------------
*.exe
*.dll
*.pdb
*.mdb
*.obj

# ------------------------
# Keep code source
# ------------------------
# Tous les fichiers .cs dans src/ restent suivis
/src/**/*.cs
